{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO Audit Finding",
  "type": "object",
  "required": [
    "id",
    "category",
    "severity",
    "scope",
    "summary",
    "evidence",
    "why_it_matters",
    "recommendation",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable machine-readable identifier for the finding."
    },
    "category": {
      "type": "string",
      "description": "Audit family such as crawlability, indexability, content, schema, or media."
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "scope": {
      "type": "string",
      "enum": ["site", "template", "url", "asset", "query", "property"]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": {
            "type": "string",
            "description": "Evidence type such as url, screenshot, html, header, metric, or quote."
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "why_it_matters": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "affected_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "owner": {
      "type": "string"
    },
    "estimated_effort": {
      "type": "string",
      "enum": ["xs", "s", "m", "l", "xl"]
    }
  },
  "additionalProperties": false
}
